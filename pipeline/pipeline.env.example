# Configuracao do servico de pipeline unificada.
# Referencia os arquivos dos modulos de cameras e CVAT.
PIPELINE='{
  "cameras": {
    "env_file": "digifort-scripts/.env"
  },
  "cvat": {
    "enabled": true,
    "env_file": "cvat_scripts/.env"
  }
}'

# Intervalo padrao de retry infinito para cameras e CVAT (em segundos)
RESTART_SECONDS=13

# Opcoes de comportamento como servico:
# - Se o CVAT estiver fora do ar ou recusar credenciais: o servico nao para.
#   Ele retenta a cada 13 segundos infinitamente, enquanto a coleta grava fotos no disco.
# - Ao restabelecer a conexao, as imagens acumuladas sao enviadas automaticamente.
# - Para simular sem criar tasks reais: use a flag --dry-run ou DRY_RUN=true no .env do CVAT.
