# Conexao CVAT compartilhada por todas as pastas.
CVAT_URL=http://SERVIDOR:8080
CVAT_USERNAME=seu_usuario
CVAT_PASSWORD='sua_senha'
CVAT_ORGANIZATION=

# Modo de execucao e padrao de remocao (pode ser substituido por pasta).
DRY_RUN=true
LOOP=true
POLL_INTERVAL_SECONDS=5
AUTO_REMOVE=false

# Uma entrada por pasta de camera. Mantenha somente as pastas que deseja usar.
# O nome da pasta e o nome da camera nas tasks: VO2C01, VO2C02, etc.
# Cada entrada escolhe seu projeto, seu lote e se remove apos confirmar o upload.
FOLDERS='[
  {
    "images_dir": "../digifort-scripts/volume/image/VO2C01",
    "project_id": 8,
    "images_per_task": 50,
    "auto_remove": true
  },
  {
    "images_dir": "../digifort-scripts/volume/image/VO2C02",
    "project_id": 12,
    "images_per_task": 100,
    "auto_remove": false
  }
]'

# Para uma unica pasta, deixe somente um objeto na lista.
# Para varias pastas no mesmo projeto, repita o project_id em objetos diferentes.
# Caminho Windows: "images_dir": "C:/datasets/Imagens para anotacao/VO2C03".
# Organizacao diferente: adicione "organization": "minha-organizacao" ao objeto.
# images_per_task omitido usa 50; auto_remove omitido herda AUTO_REMOVE global.
# organization omitido herda CVAT_ORGANIZATION; "organization": "" usa o contexto padrao.
# Use true/false JSON sem aspas. Nao coloque comentarios dentro da lista JSON.
# Nao repita uma pasta; nomes de camera iguais no mesmo projeto tambem sao rejeitados.

# Como funciona:
# - Verifica cada pasta/projeto; uma falha nao impede verificar as outras pastas.
# - Busca a ultima data final das tasks daquela camera no projeto escolhido.
# - Ignora imagens anteriores/iguais e aguarda completar images_per_task.
# - Envia lotes completos; so remove o lote apos confirmar quantidade e nomes no CVAT.
# - Espera POLL_INTERVAL_SECONDS apos verificar todas as pastas e repete.
# - --dry-run verifica todas uma vez, sem criar tasks nem apagar arquivos.
# - --send envia e continua em loop; --send --once verifica todas uma vez.
# - Tasks com sufixo ' | uploading' exigem revisao em caso de falha.
# - Nunca remove .history.json, .part nem imagens fora do lote confirmado.