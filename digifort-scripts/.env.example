# Copie para .env e substitua os enderecos/nomes de cameras.
# A lista abaixo reune 10 exemplos: mantenha apenas os objetos que deseja usar.
# Nao coloque comentarios dentro do JSON e nao repita nomes de pasta.
# Camera 01: ultimos 30 dias, depois continua ao vivo sem data final.
# Camera 02: apenas o periodo fixo informado, incluindo a data/hora final.
# Camera 03: ultimos 30 dias ate agora, depois encerra.
# Camera 04: desde a gravacao mais antiga, depois continua ao vivo.
# Camera 05: desde a gravacao mais antiga ate agora, depois encerra.
# Camera 06: ultimas 12 horas ate agora, depois encerra.
# Camera 07: periodo entre 30 dias atras e 7 dias atras.
# Camera 08: HTTP/HTTPS comum, somente ao vivo, continuamente.
# Camera 09: coleta ao vivo agendada com inicio e fim (ajuste as datas futuras).
# Camera 10: Digifort ao vivo em Full HD, com resize local e autenticacao Basic.
CAMERAS='[
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_01",
    "folder": "camera_01",
    "interval_seconds": 60,
    "history": true,
    "start_date": 30,
    "end_date": null,
    "quality": 100,
    "resize": null,
    "history_search_hours": 6,
    "history_retry_seconds": 30
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_02",
    "folder": "camera_02",
    "interval_seconds": 120,
    "history": true,
    "start_date": "2026-10-01T08:00:00",
    "end_date": "2026-10-02T18:00:00",
    "resize": [1280, 720]
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_03",
    "folder": "camera_03_ultimos_30_dias",
    "interval_seconds": 60,
    "history": true,
    "start_date": 30,
    "end_date": 0
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_04",
    "folder": "camera_04_mais_antiga_continuo",
    "interval_seconds": 60,
    "history": true,
    "start_date": null,
    "end_date": null
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_05",
    "folder": "camera_05_mais_antiga_ate_agora",
    "interval_seconds": 300,
    "history": true,
    "start_date": null,
    "end_date": 0
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_06",
    "folder": "camera_06_ultimas_12_horas",
    "interval_seconds": 30,
    "history": true,
    "start_date": 0.5,
    "end_date": 0
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_07",
    "folder": "camera_07_de_30_a_7_dias_atras",
    "interval_seconds": 600,
    "history": true,
    "start_date": 30,
    "end_date": 7
  },
  {
    "url": "https://CAMERA/image.jpg",
    "folder": "camera_08_http_ao_vivo",
    "interval_seconds": 60,
    "history": false,
    "start_date": null,
    "end_date": null
  },
  {
    "url": "http://SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_09",
    "folder": "camera_09_agendada",
    "interval_seconds": 120,
    "history": false,
    "start_date": "2026-10-30T08:00:00-03:00",
    "end_date": "2026-10-30T18:00:00-03:00"
  },
  {
    "url": "http://USUARIO:SENHA@SERVIDOR:8601/Interface/Cameras/GetSnapshot?Camera=CAMERA_10",
    "folder": "camera_10_full_hd_resize",
    "interval_seconds": 60,
    "history": false,
    "capture_resolution": [1920, 1080],
    "quality": 100,
    "resize": [1280, 720]
  }
]'

OUTPUT_DIR=./volume/image
REQUEST_TIMEOUT=10

# start_date: data/hora ISO ou numero de dias atras (30, sem aspas).
# start_date null/omitido: gravacao mais antiga (history=true) ou agora (false).
# end_date: data/hora ISO; 0 para o momento da inicializacao; null/omitido para infinito.
# Para os ultimos 30 dias sem continuar ao vivo: start_date=30 e end_date=0 no JSON.
# Datas sem fuso usam o horario local; tambem pode usar 2026-10-29T08:00:00-03:00.
# Imagens existentes tem prioridade: retoma da ultima + intervalo, respeitando o fim.
# Use outra pasta vazia para coletar novamente um periodo anterior.
# resize null/omitido preserva os bytes; [largura, altura] reduz mantendo a proporcao.
# Digifort ao vivo: capture_resolution padrao [1920, 1080], quality padrao 100.
# Digifort historico: tamanho original se capture_resolution for omitido.
# URLs HTTP comuns: history=false; somente snapshots atuais, sem recuperar o passado.
# Datas relativas sao calculadas na inicializacao, sem mover a janela durante a coleta.
# Intervalos uteis: 30 = 30s; 60 = 1min; 300 = 5min; 600 = 10min; 3600 = 1h.
# history_search_hours=6 avanca 6 horas no historico, sem esperar 6 horas reais.
# Credenciais com caracteres especiais devem ser codificadas na URL: @ vira %40.
# Para a mesma camera em periodos diferentes, use nomes de pasta diferentes.
