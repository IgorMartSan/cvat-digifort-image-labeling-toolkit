# A pipeline referencia os arquivos dos scripts, sem duplicar cameras ou senhas.
PIPELINE='{
  "cameras": {
    "env_file": "digifort-scripts/.env"
  },
  "cvat": {
    "enabled": true,
    "env_file": "cvat_scripts/.env"
  }
}'

RESTART_SECONDS=13

# Sem CVAT: remova o objeto "cvat" ou use "enabled": false.
# Arquivo CVAT ausente/incompleto: coleta continua, sem iniciar o uploader.
# CVAT indisponivel/login recusado: uploader tenta novamente, coleta continua.
# A etapa CVAT usa o DRY_RUN do arquivo referenciado. Para enviar, defina DRY_RUN=false.
# Para apenas conferir os arquivos e etapas: uv run python pipeline.py --check
# Para iniciar somente a coleta: uv run python pipeline.py --collect-only
# Reinicie a pipeline depois de corrigir/adicionar a configuracao do CVAT.
